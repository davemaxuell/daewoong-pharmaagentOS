# Include both service roots and the reviewed resources required by the API build.
/*
!vercel.json
!.vercelignore
!apps
!services
!contracts
!fixtures
!scripts
/fixtures/*
!/fixtures/internal_quality
/scripts/*
!/scripts/prepare-vercel-resources.py

# Never upload local dependencies, build products, tests, data, or secrets.
/apps/web/node_modules/
/apps/web/.next/
/apps/web/tests/
/apps/web/test-results/
/apps/web/playwright-report/
/apps/web/output/
/apps/web/.env*

/services/api/.venv*/
/services/api/.pytest_cache/
/services/api/.ruff_cache/
/services/api/__pycache__/
/services/api/tests/
/services/api/data/
/services/api/.env*
/services/api/app/_resources/
**/__pycache__/
**/*.py[cod]
**/.env*
**/*.pem
**/*.key
