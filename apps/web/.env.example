# Server-only API origin. When omitted, the portal uses an isolated seeded preview.
API_BASE_URL=http://localhost:8000

# Google and Naver Auth.js login is mandatory in every environment. Configure both
# providers before giving users access to the portal.
# Google callback URL: http://localhost:3000/api/auth/callback/google
# Naver callback URL: http://localhost:3000/api/auth/callback/naver
# Production callbacks: https://YOUR_DOMAIN/api/auth/callback/{google,naver}
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# Public mode admits every verified account as viewer. Restricted mode admits
# only subjects present in the directory, including explicitly assigned viewers.
AUTH_ADMISSION_MODE=public
# Every successfully verified Google or Naver account in public mode defaults to viewer. Assign
# additional roles only by immutable provider subject in this server-only JSON map.
# Example: {"google:0123456789":["analyst"],"naver:abc123":["reviewer"]}
AUTH_SUBJECT_ROLE_ASSIGNMENTS_JSON={}

# Short-lived web-to-API JWT assertion. Generate a PKCS#8 RSA key with:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
# Store the matching public key only in the API service. Never use this key in NEXT_PUBLIC_*.
API_SESSION_PRIVATE_KEY=
API_SESSION_KEY_ID=web-session-v1
API_SESSION_ISSUER=daewoong-fda-web
API_SESSION_AUDIENCE=daewoong-fda-api
