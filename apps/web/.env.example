# Server-only API origin; omit it for the clearly labelled local preview.
API_BASE_URL=http://localhost:8000

# No login or OAuth providers. This signing secret isolates anonymous browser sessions.
# Generate a random value with at least 32 characters; use separate hosted environments.
PORTAL_SESSION_SECRET=

# Server-only RS256 assertion for the private API. Public sessions have viewer authority.
API_SESSION_PRIVATE_KEY=
API_SESSION_KEY_ID=web-session-v1
API_SESSION_ISSUER=pharma-agent-os-web
API_SESSION_AUDIENCE=pharma-agent-os-api
