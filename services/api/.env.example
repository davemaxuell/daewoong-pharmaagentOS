APP_ENV=local
EMBEDDED_WORKER_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./data/fda_intel.db
AUTO_CREATE_SCHEMA=true
# Local development uses the filesystem. Railway API/worker/cron services use
# `s3` and reference a private Railway Bucket's BUCKET, ENDPOINT, REGION and keys.
OBJECT_STORE_BACKEND=local
OBJECT_STORE_PATH=./data/objects
# OBJECT_STORE_S3_ENDPOINT=https://storage.railway.app
# OBJECT_STORE_S3_BUCKET=globally-unique-s3-bucket-name
# OBJECT_STORE_S3_ACCESS_KEY_ID=replace-from-secret-manager
# OBJECT_STORE_S3_SECRET_ACCESS_KEY=replace-from-secret-manager
# OBJECT_STORE_S3_REGION=auto
# OBJECT_STORE_S3_URL_STYLE=virtual
DEV_AUTH_ENABLED=true
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
FDA_ALLOWED_HOSTS=["www.fda.gov","fda.gov"]
FDA_USER_AGENT=Daewoong-FDA-Drug-Intel/0.1 (contact: configure-before-network-use)
FDA_REQUEST_DELAY_SECONDS=30
FDA_ROBOTS_CACHE_SECONDS=3600
FDA_ROBOTS_FAIL_CLOSED=true
FDA_LISTING_URL=https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/compliance-actions-and-activities/warning-letters
# Initial discovery/backfill admits the most recent 3 calendar years. Letters
# remain in active search/RAG until their issue/posted date is 5 years old.
CORPUS_BACKFILL_YEARS=3
CORPUS_ACTIVE_RETENTION_YEARS=5
# A delivery outbox is always audited, but SMTP remains disabled until a real
# provider is configured. Never commit SMTP credentials.
NOTIFICATION_DEFAULT_RECIPIENT=grisellacrystabel@gmail.com
SMTP_ENABLED=false
# Test sender configuration. Keep delivery disabled until a dedicated Google App
# Password is supplied through the secret manager; never use the mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=apotekerwork@gmail.com
# SMTP_PASSWORD=replace-from-secret-manager
SMTP_FROM_EMAIL=apotekerwork@gmail.com
SMTP_FROM_NAME=Daewoong FDA Warning Letter Update
SMTP_STARTTLS=true
SMTP_USE_SSL=false
# AI generation is disabled unless both settings below are supplied server-side.
LLM_PROVIDER=none
LLM_MODEL_ID=gemini-3.1-flash-lite
CHAT_FAST_MODEL_ID=gemini-3.1-flash-lite
CHAT_BALANCED_MODEL_ID=gemini-3.5-flash
CHAT_DEEP_MODEL_ID=gemini-3.7-flash
LLM_PROMPT_VERSION=rag-grounded-v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1200
# Semantic retrieval is opt-in and uses the same server-side Gemini secret. PostgreSQL
# deployments must enable pgvector. 1536 is the fixed schema dimension; changing models or
# dimensions requires a full, controlled re-embedding.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL_ID=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
# Persisted Korean translations and letter analyses use a separate stable model.
DOCUMENT_AI_MODEL_ID=gemini-3.7-flash
DOCUMENT_AI_FALLBACK_MODEL_IDS=["gemini-3.6-flash","gemini-3.5-flash"]
DOCUMENT_AI_PROMPT_VERSION=letter-artifacts-bilingual-v2
DOCUMENT_TRANSLATION_MODEL_ID=gemini-3.7-flash
DOCUMENT_TRANSLATION_FALLBACK_MODEL_IDS=["gemini-3.6-flash","gemini-3.5-flash","gemini-3.1-flash-lite"]
DOCUMENT_TRANSLATION_PROMPT_VERSION=letter-translation-ko-v4
DOCUMENT_AI_TIMEOUT_SECONDS=90
DOCUMENT_AI_MAX_OUTPUT_TOKENS=16384
DOCUMENT_AI_ATTEMPTS_PER_MODEL=2
DOCUMENT_AI_RETRY_BACKOFF_SECONDS=0.5
DOCUMENT_AI_RATE_LIMIT_BACKOFF_SECONDS=2
DOCUMENT_AI_RATE_LIMIT_PER_MINUTE=10
# GEMINI_API_KEY=replace-with-a-rotated-key-from-your-secret-manager
# The Next.js BFF validates Google login, then signs a 90-second application JWT.
# Keep the RSA private key only in the web service and configure the matching
# public key here. Literal PEM newlines may be encoded as \\n in environment stores.
# OIDC_ISSUER=daewoong-fda-web
# OIDC_AUDIENCE=daewoong-fda-api
# OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----
# OIDC_ALGORITHMS=["RS256"]
