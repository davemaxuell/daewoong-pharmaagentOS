{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pharma-agent-os:schema:skill-library:1.0.0",
  "title": "PharmaAgent OS skill library",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "skills"],
  "properties": {
    "apiVersion": { "const": "pharmaagent.io/v1" },
    "kind": { "const": "SkillLibrary" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "owner", "releaseState"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 160 },
        "releaseState": { "enum": ["DRAFT", "DEVELOPMENT", "TESTING", "STAGING", "APPROVED", "PRODUCTION", "SUSPENDED", "RETIRED"] }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 10,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "displayName", "intendedUse", "requiredOutput", "prohibitedBehavior", "instructions"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
          "intendedUse": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "requiredOutput": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "prohibitedBehavior": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
          "instructions": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    }
  }
}
