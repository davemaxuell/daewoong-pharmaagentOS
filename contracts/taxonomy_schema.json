{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daewoong.example.internal/schemas/fda-drug-taxonomy/v1.0.0",
  "title": "FDA Drug finding taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "status",
    "effective_date",
    "scope",
    "categories",
    "drug_subtypes",
    "process_lenses",
    "attention_levels",
    "comparison_point_policy",
    "change_control"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^drug-taxonomy-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": { "enum": ["proposed", "active", "retired"] },
    "effective_date": { "type": "string", "format": "date" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authority", "required_product_class", "admission_rule", "note"],
      "properties": {
        "source_authority": { "type": "string", "minLength": 1 },
        "required_product_class": { "const": "Drugs" },
        "admission_rule": { "const": "exact_normalized_product_class_contains_Drugs" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "drug_subtypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/labeledItem" }
    },
    "process_lenses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/processLens" }
    },
    "attention_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "disclaimer"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/labeledItem" }
        },
        "disclaimer": { "type": "string", "minLength": 1 }
      }
    },
    "comparison_point_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "grammatical_form", "prohibited_conclusions"],
      "properties": {
        "prefix": { "type": "string", "minLength": 1 },
        "grammatical_form": { "const": "question" },
        "prohibited_conclusions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "requires_regression_evaluation", "retain_historical_versions", "breaking_change_rule"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "requires_regression_evaluation": { "const": true },
        "retain_historical_versions": { "const": true },
        "breaking_change_rule": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "labeledItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "aliases"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "processLens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "examples"],
      "properties": {
        "id": { "enum": ["preventive", "monitoring", "retrospective"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}

