{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daewoong.example.internal/schemas/fda-drug-summary/v1.0.0",
  "title": "Grounded FDA Product: Drugs warning-letter summary",
  "description": "Strict extraction contract. Material claims require exact stored source anchors and excerpts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_identity",
    "executive_summary",
    "scope",
    "violations",
    "response_deadline",
    "enforcement_consequences",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_identity": {
      "$ref": "#/$defs/documentIdentity"
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      },
      "maxItems": 100
    },
    "response_deadline": {
      "oneOf": [
        {
          "$ref": "#/$defs/responseDeadline"
        },
        {
          "type": "null"
        }
      ]
    },
    "enforcement_consequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groundedStatement"
      },
      "maxItems": 30
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      },
      "maxItems": 50
    }
  },
  "$defs": {
    "nullableShortString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "documentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_name",
        "document_type",
        "marcs_cms_number",
        "issue_date",
        "posted_date",
        "issuing_offices",
        "source_url"
      ],
      "properties": {
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "document_type": {
          "enum": [
            "warning_letter",
            "response",
            "closeout"
          ]
        },
        "marcs_cms_number": {
          "$ref": "#/$defs/nullableShortString"
        },
        "issue_date": {
          "$ref": "#/$defs/nullableDate"
        },
        "posted_date": {
          "$ref": "#/$defs/nullableDate"
        },
        "issuing_offices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://([A-Za-z0-9-]+\\.)*fda\\.gov/"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_types",
        "drug_subtypes",
        "facility_types"
      ],
      "properties": {
        "product_types": {
          "type": "array",
          "contains": {
            "const": "Drugs"
          },
          "minContains": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 20
        },
        "drug_subtypes": {
          "type": "array",
          "items": {
            "enum": [
              "Finished pharmaceutical",
              "Prescription drug",
              "OTC drug",
              "API",
              "Sterile drug",
              "Non-sterile drug",
              "Compounded/503A/503B-related context",
              "Contract manufacturer",
              "Contract testing laboratory",
              "Registration/listing-focused enforcement",
              "Other/unknown"
            ]
          },
          "uniqueItems": true,
          "maxItems": 11
        },
        "facility_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "maxItems": 30
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_anchor",
        "excerpt"
      ],
      "properties": {
        "source_anchor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 200
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "requestedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "evidence"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "categories",
        "process_lenses",
        "finding",
        "regulatory_references",
        "evidence",
        "fda_requested_actions",
        "comparison_points",
        "attention_level",
        "confidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 22
        },
        "process_lenses": {
          "type": "array",
          "items": {
            "enum": [
              "preventive",
              "monitoring",
              "retrospective"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "regulatory_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 30
        },
        "fda_requested_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requestedAction"
          },
          "maxItems": 30
        },
        "comparison_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 3000,
            "pattern": "\\?$"
          },
          "maxItems": 30
        },
        "attention_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "category": {
      "enum": [
        "Quality Unit / QA Oversight",
        "Documentation / GDP / Batch Records",
        "Data Integrity / Computerized Systems / Audit Trail",
        "Training / Qualification / Personnel Practices",
        "Deviations / Investigations / OOS / OOT / CAPA",
        "Aseptic Processing / Sterility Assurance / Media Fill",
        "Contamination Control / Cleaning / Disinfection",
        "Process Validation / PPQ / Continued Process Verification",
        "Equipment / Qualification / Calibration / Maintenance",
        "Facilities / Utilities / HVAC / Water Systems",
        "Laboratory Controls / Method Validation / Microbiology",
        "Stability / Expiry / Retest / Reserve Samples",
        "Materials / Components / Supplier Qualification / COA Reliability",
        "Packaging / Labeling / Container-Closure",
        "Complaints / Adverse Events / Recall / Market Action",
        "Contract Manufacturing / Contract Laboratory / Outsourced Activities",
        "API Manufacturing / ICH Q7-related CGMP",
        "Drug Establishment Registration / Listing / NDC",
        "Misbranding / Unapproved Drug / Marketing Authorization",
        "Distribution / Warehousing / Supply Chain",
        "Change Management",
        "Other Drug Regulatory / CGMP"
      ]
    },
    "responseDeadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "source_anchor",
        "excerpt"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "unit": {
          "enum": [
            "calendar_days",
            "working_days"
          ]
        },
        "source_anchor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 200
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "groundedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_anchor": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0.0",
      "document_identity": {
        "company_name": "Tianjin Kilo Pharmaceutical Sci-tech Co., Ltd.",
        "document_type": "warning_letter",
        "marcs_cms_number": "731761",
        "issue_date": "2026-08-06",
        "posted_date": "2026-08-18",
        "issuing_offices": [
          "Center for Drug Evaluation and Research"
        ],
        "source_url": "https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/warning-letters/tianjin-kilo-pharmaceutical-sci-tech-co-ltd-731761-08062026"
      },
      "executive_summary": "FDA described deficiencies concerning API process validation and production records.",
      "scope": {
        "product_types": [
          "Drugs"
        ],
        "drug_subtypes": [
          "API"
        ],
        "facility_types": [
          "API manufacturer"
        ]
      },
      "violations": [
        {
          "label": "1",
          "categories": [
            "Process Validation / PPQ / Continued Process Verification",
            "API Manufacturing / ICH Q7-related CGMP"
          ],
          "process_lenses": [
            "preventive",
            "monitoring"
          ],
          "finding": "FDA stated that the firm had not adequately demonstrated a state of control for its commercial API process.",
          "regulatory_references": [],
          "evidence": [
            {
              "source_anchor": "violation-1",
              "excerpt": "Illustrative excerpt placeholder for contract validation; replace with the exact stored FDA source excerpt."
            }
          ],
          "fda_requested_actions": [],
          "comparison_points": [
            "Are commercial API processes supported by an approved lifecycle validation and continued-verification strategy?"
          ],
          "attention_level": "high",
          "confidence": 0.95
        }
      ],
      "response_deadline": null,
      "enforcement_consequences": [],
      "uncertainties": []
    }
  ]
}
