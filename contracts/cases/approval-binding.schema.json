{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daewoong.example.internal/schemas/pharma-agent-os/approval-binding/v1.0.0",
  "title": "PharmaAgent OS Approval Binding",
  "description": "Human approval bound to one exact case state and immutable plan version. A changed plan cannot reuse this approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "status",
    "requester_user_id",
    "approver_user_id",
    "binding",
    "risk_class",
    "proposed_action",
    "affected_assets",
    "supporting_evidence_refs",
    "requested_at",
    "decided_at",
    "decision_reason",
    "expires_at",
    "decision_append_only"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "approval_id": { "type": "string", "format": "uuid" },
    "approval_type": {
      "enum": [
        "PLAN_APPROVAL",
        "SENSITIVE_DATA_ACCESS",
        "SIDE_EFFECT_APPROVAL",
        "SME_REVIEW",
        "ARTIFACT_APPROVAL",
        "AGENT_RELEASE_APPROVAL",
        "POLICY_EXCEPTION"
      ]
    },
    "status": { "enum": ["REQUESTED", "APPROVED", "REJECTED", "EXPIRED", "REVOKED"] },
    "requester_user_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "approver_user_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        { "type": "null" }
      ]
    },
    "binding": { "$ref": "#/$defs/binding" },
    "risk_class": { "enum": ["R0", "R1", "R2", "R3"] },
    "proposed_action": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "affected_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetReference" },
      "uniqueItems": true,
      "maxItems": 500
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 },
      "uniqueItems": true,
      "maxItems": 500
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "decided_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "decision_reason": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 4000 },
        { "type": "null" }
      ]
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "decision_append_only": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "REQUESTED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approver_user_id": { "type": "null" },
          "decided_at": { "type": "null" },
          "decision_reason": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "approver_user_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "decided_at": { "type": "string", "format": "date-time" },
          "decision_reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "definitionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "definition_hash"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "version": { "$ref": "#/$defs/semver" },
        "definition_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "toolScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "required_scopes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$" },
        "version": { "$ref": "#/$defs/semver" },
        "required_scopes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$" },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "dataScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_source_id", "source_version_id", "source_hash"],
      "properties": {
        "case_source_id": { "type": "string", "format": "uuid" },
        "source_version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_agent_invocations",
        "max_parallel_agents",
        "max_turns",
        "max_tool_calls",
        "max_correction_loops",
        "max_input_tokens",
        "max_output_tokens",
        "max_runtime_seconds",
        "max_cost_usd"
      ],
      "properties": {
        "max_agent_invocations": { "type": "integer", "minimum": 1 },
        "max_parallel_agents": { "type": "integer", "minimum": 1 },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_correction_loops": { "type": "integer", "minimum": 0, "maximum": 2 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "case_id",
        "current_state_hash",
        "plan_id",
        "plan_version",
        "plan_hash",
        "workflow",
        "agent_versions",
        "tool_scopes",
        "data_scope",
        "budget"
      ],
      "properties": {
        "scope": { "const": "SINGLE_PLAN_VERSION" },
        "case_id": { "type": "string", "format": "uuid" },
        "current_state_hash": { "$ref": "#/$defs/sha256" },
        "plan_id": { "type": "string", "format": "uuid" },
        "plan_version": { "type": "integer", "minimum": 1 },
        "plan_hash": { "$ref": "#/$defs/sha256" },
        "workflow": { "$ref": "#/$defs/definitionReference" },
        "agent_versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/definitionReference" },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 20
        },
        "tool_scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolScope" },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 100
        },
        "data_scope": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataScope" },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 500
        },
        "budget": { "$ref": "#/$defs/budget" }
      }
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "enum": ["CASE", "CASE_SOURCE", "CASE_PLAN", "INTERNAL_ASSET", "ARTIFACT"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
