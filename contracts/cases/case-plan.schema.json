{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daewoong.example.internal/schemas/pharma-agent-os/case-plan/v1.0.0",
  "title": "PharmaAgent OS CasePlan",
  "description": "Immutable, versioned execution plan. Approval applies only to its exact canonical hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "case_id",
    "version",
    "status",
    "objective",
    "scope",
    "workflow",
    "source_pins",
    "agent_versions",
    "tool_permissions",
    "assumptions",
    "risks",
    "steps",
    "budget",
    "approval_requirement",
    "prohibited_actions",
    "based_on_plan_version",
    "plan_hash",
    "hash_algorithm",
    "canonicalization",
    "created_by_user_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["GENERATED", "AWAITING_APPROVAL", "APPROVED", "REJECTED", "SUPERSEDED"]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "$ref": "#/$defs/planScope"
    },
    "workflow": {
      "$ref": "#/$defs/definitionReference"
    },
    "source_pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcePin"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "agent_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definitionReference"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 20
    },
    "tool_permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolPermission"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "https://daewoong.example.internal/schemas/pharma-agent-os/plan-step/v1.0.0"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "budget": {
      "$ref": "#/$defs/planBudget"
    },
    "approval_requirement": {
      "enum": ["AUTO_AUTHORIZED_BY_POLICY", "PLAN_APPROVAL_REQUIRED"]
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "enum": [
          "MODIFY_CONTROLLED_DOCUMENT",
          "CREATE_CAPA",
          "APPROVE_CAPA",
          "UPDATE_QMS_RECORD",
          "UPDATE_EDMS_RECORD",
          "UPDATE_MES_RECORD",
          "UPDATE_LIMS_RECORD",
          "RELEASE_OR_REJECT_PRODUCT",
          "SUBMIT_TO_REGULATOR"
        ]
      },
      "uniqueItems": true,
      "minItems": 9,
      "maxItems": 9
    },
    "based_on_plan_version": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "created_by_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "definitionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "definition_hash"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "definition_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "toolPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "required_scopes"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_source_id", "source_type", "source_version_id", "source_hash", "trust_level"],
      "properties": {
        "case_source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_type": {
          "enum": ["FDA_WARNING_LETTER_DOCUMENT_VERSION", "INTERNAL_ASSET_VERSION", "USER_PROVIDED_SNAPSHOT"]
        },
        "source_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_hash": {
          "$ref": "#/$defs/sha256"
        },
        "trust_level": {
          "enum": ["AUTHORITATIVE_EXTERNAL", "CONTROLLED_INTERNAL", "USER_PROVIDED_CONTEXT"]
        }
      }
    },
    "planScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "domain_lenses"],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 100
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "domain_lenses": {
          "type": "array",
          "items": {
            "enum": [
              "REGULATORY_EVIDENCE",
              "DATA_INTEGRITY",
              "STERILE_MANUFACTURING",
              "LABORATORY_CONTROLS",
              "TRAINING_QUALIFICATION",
              "QUALITY_SYSTEMS"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 6
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "risk_class", "description", "mitigation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "risk_class": {
          "enum": ["R0", "R1", "R2", "R3"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "planBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_agent_invocations",
        "max_parallel_agents",
        "max_turns",
        "max_tool_calls",
        "max_correction_loops",
        "max_input_tokens",
        "max_output_tokens",
        "max_runtime_seconds",
        "max_cost_usd"
      ],
      "properties": {
        "max_agent_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_parallel_agents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "max_correction_loops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    }
  }
}
