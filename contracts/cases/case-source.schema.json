{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daewoong.example.internal/schemas/pharma-agent-os/case-source/v1.0.0",
  "title": "PharmaAgent OS CaseSource",
  "description": "Immutable link from a case to an exact retained source version and hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_source_id",
    "case_id",
    "source_role",
    "source_type",
    "source_system",
    "source_id",
    "source_version_id",
    "source_hash",
    "trust_level",
    "authorization_snapshot_hash",
    "pinned_by_user_id",
    "pinned_at",
    "immutable"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_source_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_role": {
      "enum": [
        "PRIMARY_REGULATORY",
        "SUPPORTING_REGULATORY",
        "INTERNAL_REVIEW_SCOPE",
        "USER_CONTEXT"
      ]
    },
    "source_type": {
      "enum": [
        "FDA_WARNING_LETTER_DOCUMENT_VERSION",
        "INTERNAL_ASSET_VERSION",
        "USER_PROVIDED_SNAPSHOT"
      ]
    },
    "source_system": {
      "enum": ["FDA_EVIDENCE_SERVICE", "INTERNAL_KNOWLEDGE_SERVICE", "CASE_UPLOAD_STORE"]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_hash": {
      "$ref": "#/$defs/sha256"
    },
    "trust_level": {
      "enum": ["AUTHORITATIVE_EXTERNAL", "CONTROLLED_INTERNAL", "USER_PROVIDED_CONTEXT"]
    },
    "authorization_snapshot_hash": {
      "$ref": "#/$defs/sha256"
    },
    "pinned_by_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pinned_at": {
      "type": "string",
      "format": "date-time"
    },
    "immutable": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "FDA_WARNING_LETTER_DOCUMENT_VERSION"
          }
        },
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "source_system": {
            "const": "FDA_EVIDENCE_SERVICE"
          },
          "trust_level": {
            "const": "AUTHORITATIVE_EXTERNAL"
          },
          "source_version_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
