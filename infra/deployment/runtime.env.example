# Non-secret production configuration shape. Values are placeholders and must be
# reconciled with the target environment and corporate control owners.
APP_ENV=production
APP_VERSION=0.1.0
AUTO_CREATE_SCHEMA=false
DEV_AUTH_ENABLED=false

FDA_LISTING_URL=https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/compliance-actions-and-activities/warning-letters
FDA_ALLOWED_HOSTS=["www.fda.gov","fda.gov"]
FDA_USER_AGENT=Daewoong-FDA-Drug-Intel/0.1 (contact: replace-with-controlled-contact)
FDA_REQUEST_DELAY_SECONDS=30
DRUG_SCOPE_RULE_VERSION=drug-scope-v1
PARSER_VERSION=fda-html-datatables-v3
TAXONOMY_VERSION=drug-taxonomy-v1.0.0
CHUNKER_VERSION=structure-v1

# `DATABASE_URL` is injected from a secret, not this file. For Railway, bind the
# same environment-scoped private bucket to API, worker and cron with Railway
# variable references; `BUCKET` is the S3 API name, not `RAILWAY_BUCKET_NAME`.
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_S3_ENDPOINT=${{fda-objects.ENDPOINT}}
OBJECT_STORE_S3_BUCKET=${{fda-objects.BUCKET}}
OBJECT_STORE_S3_ACCESS_KEY_ID=${{fda-objects.ACCESS_KEY_ID}}
OBJECT_STORE_S3_SECRET_ACCESS_KEY=${{fda-objects.SECRET_ACCESS_KEY}}
OBJECT_STORE_S3_REGION=${{fda-objects.REGION}}
OBJECT_STORE_S3_URL_STYLE=virtual
LLM_PROVIDER=gemini
LLM_MODEL_ID=gemini-3.1-flash-lite
CHAT_FAST_MODEL_ID=gemini-3.1-flash-lite
CHAT_BALANCED_MODEL_ID=gemini-3.5-flash
CHAT_DEEP_MODEL_ID=gemini-3.7-flash
EMBEDDING_ENABLED=true
EMBEDDING_MODEL_ID=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# The browser signs in with Google or Naver through Auth.js. The web server then
# issues a short-lived, audience-bound RS256 assertion to FastAPI; provider tokens
# are never forwarded to the API.
AUTH_REQUIRED=true
AUTH_URL=https://fda-intel.internal.example
AUTH_TRUST_HOST=true
AUTH_ADMISSION_MODE=restricted
AUTH_SUBJECT_ROLE_ASSIGNMENTS_JSON={"google:immutable-subject-1":["analyst"],"naver:immutable-subject-2":["reviewer"]}
NOTIFICATION_DEFAULT_RECIPIENT=notifications@example.com
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=apotekerwork@gmail.com
SMTP_FROM_NAME=Daewoong FDA Warning Letter Update
SMTP_STARTTLS=true
SMTP_USE_SSL=false
API_SESSION_ISSUER=daewoong-fda-web
API_SESSION_AUDIENCE=daewoong-fda-api
API_SESSION_KEY_ID=web-session-v1
OIDC_ISSUER=daewoong-fda-web
OIDC_AUDIENCE=daewoong-fda-api
OIDC_ALGORITHMS=["RS256"]
OIDC_ROLE_CLAIM=roles
ALLOWED_ORIGINS=["https://fda-intel.internal.example"]
ALLOWED_HOSTS=["fda-intel.internal.example"]

# Durable agent execution. Production Temporal requires mTLS files mounted from
# the workload-specific secret; local development may leave Temporal disabled.
AGENT_RUN_RATE_LIMIT_PER_HOUR=20
AGENT_ACTIVE_RUNS_PER_SUBJECT=5
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal-frontend.temporal.svc.cluster.local:7233
TEMPORAL_NAMESPACE=pharma-agent-os
TEMPORAL_TASK_QUEUE=pharma-case-workflows
TEMPORAL_TLS_ENABLED=true
TEMPORAL_TLS_CA_PATH=/var/run/secrets/temporal/ca.crt
TEMPORAL_TLS_CERT_PATH=/var/run/secrets/temporal/tls.crt
TEMPORAL_TLS_KEY_PATH=/var/run/secrets/temporal/tls.key
OTEL_SERVICE_NAME=pharma-agent-os
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.observability.svc.cluster.local:4318/v1/traces
SECRET_PROVIDER=aws
SECRETS_AWS_REGION=ap-northeast-2
SECRETS_AWS_PREFIX=pharma-agent-os/

# Supply `DATABASE_URL`, `GEMINI_API_KEY`, SMTP credentials, Google/Naver OAuth
# credentials, `AUTH_SECRET`, and the RSA application-session keys through the
# approved secret manager. SIEM/object-store/gateway adapters require a reviewed
# platform integration; unknown placeholder variables are not treated as active.
