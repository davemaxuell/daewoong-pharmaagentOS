# Railway API service. Replace every REPLACE_ value before deploying.
# Build context /; custom start command: python -m app.serve
RAILWAY_DOCKERFILE_PATH=services/api/Dockerfile
APP_ENV=production
AUTO_CREATE_SCHEMA=false
DEV_AUTH_ENABLED=false
DEBUG=false
SECRET_PROVIDER=railway
TELEMETRY_BACKEND=railway_logs
OTEL_SERVICE_NAME=pharma-agent-api
# RAILWAY_* runtime IDs, domains and PORT are supplied by Railway.
ALLOWED_HOSTS=healthcheck.railway.app
ALLOWED_ORIGINS=https://pharmaagent-os.vercel.app

DATABASE_URL=REPLACE_WITH_EXISTING_SUPABASE_API_ROLE_URL
OBJECT_STORE_BACKEND=supabase
SUPABASE_URL=https://wdaflyddglimtijvgazl.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_EXISTING_STORAGE_SERVER_SECRET
OBJECT_STORE_SUPABASE_BUCKET=pharma-evidence

# Match the existing Vercel signed-session configuration exactly.
OIDC_ISSUER=pharma-agent-os-web
OIDC_AUDIENCE=pharma-agent-os-api
OIDC_ALGORITHMS=RS256
OIDC_PUBLIC_KEY=REPLACE_WITH_EXISTING_PUBLIC_PEM_KEY

LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_EXISTING_OPENAI_SECRET
# OpenAI model defaults match the existing service. Copy explicit model overrides
# from Vercel if present; do not copy old Gemini model names or fallback lists.
EMBEDDING_ENABLED=false
RESEARCH_AGENT_ENABLED=true
INGESTION_WORKER_ENABLED=false
INGESTION_SCHEDULE_ENABLED=false
SERVERLESS_WORKER_ENABLED=false
EMBEDDED_WORKER_ENABLED=false
TEMPORAL_ENABLED=false
SMTP_ENABLED=false
