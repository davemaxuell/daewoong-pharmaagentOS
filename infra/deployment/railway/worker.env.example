# Railway worker service. Replace every REPLACE_ value before deploying.
# Build context /; custom start command: python -m app.background_worker
RAILWAY_DOCKERFILE_PATH=services/api/Dockerfile
APP_ENV=production
AUTO_CREATE_SCHEMA=false
DEV_AUTH_ENABLED=false
DEBUG=false
SECRET_PROVIDER=railway
TELEMETRY_BACKEND=railway_logs
OTEL_SERVICE_NAME=pharma-agent-worker
# RAILWAY_* runtime IDs/domains are supplied by Railway. No HTTP port is required.
ALLOWED_HOSTS=healthcheck.railway.app
ALLOWED_ORIGINS=https://pharmaagent-os.vercel.app

# Both worker variables use the existing dedicated worker-role URL.
DATABASE_URL=REPLACE_WITH_EXISTING_SUPABASE_WORKER_ROLE_URL
WORKER_DATABASE_URL=REPLACE_WITH_EXISTING_SUPABASE_WORKER_ROLE_URL
OBJECT_STORE_BACKEND=supabase
SUPABASE_URL=https://wdaflyddglimtijvgazl.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_EXISTING_STORAGE_SERVER_SECRET
OBJECT_STORE_SUPABASE_BUCKET=pharma-evidence
OIDC_ISSUER=pharma-agent-os-web
OIDC_AUDIENCE=pharma-agent-os-api
OIDC_ALGORITHMS=RS256
OIDC_PUBLIC_KEY=REPLACE_WITH_EXISTING_PUBLIC_PEM_KEY

LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_EXISTING_OPENAI_SECRET
EMBEDDING_ENABLED=false
RESEARCH_AGENT_ENABLED=true
INGESTION_WORKER_ENABLED=true
INGESTION_SCHEDULE_ENABLED=true
INGESTION_SCHEDULE_HOURS=24
INGESTION_REFRESH_DAYS=14
BACKGROUND_POLL_SECONDS=2
FDA_LISTING_URL=https://www.fda.gov/inspections-compliance-enforcement-and-criminal-investigations/compliance-actions-and-activities/warning-letters
FDA_ALLOWED_HOSTS=www.fda.gov,fda.gov
FDA_USER_AGENT=PharmaAgentOS/0.1 (+https://github.com/davemaxuell/daewoong-pharmaagentOS)
FDA_REQUEST_DELAY_SECONDS=30
FDA_ROBOTS_FAIL_CLOSED=true
CORPUS_BACKFILL_YEARS=3
CORPUS_ACTIVE_RETENTION_YEARS=5
SERVERLESS_WORKER_ENABLED=false
EMBEDDED_WORKER_ENABLED=false
TEMPORAL_ENABLED=false
SMTP_ENABLED=false
