# Non-secret template. Fill exact target values after choosing dedicated projects.
APP_ENV=production
AUTO_CREATE_SCHEMA=false
DEV_AUTH_ENABLED=false
DEBUG=false
EMBEDDED_WORKER_ENABLED=false
TEMPORAL_ENABLED=false
SECRET_PROVIDER=vercel
# VERCEL, VERCEL_ENV and VERCEL_PROJECT_ID are platform-provided system variables.

OBJECT_STORE_BACKEND=supabase
OBJECT_STORE_SUPABASE_BUCKET=pharma-evidence
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Store DATABASE_URL, WORKER_DATABASE_URL, and SUPABASE_SECRET_KEY as Vercel Secrets.
# Use distinct least-privilege API/worker DB users with their runtime group roles.
# Use transaction-pooler URLs (port 6543) with sslmode=require.

API_SESSION_ISSUER=pharma-agent-os-web
API_SESSION_AUDIENCE=pharma-agent-os-api
API_SESSION_KEY_ID=web-session-v1
OIDC_ISSUER=pharma-agent-os-web
OIDC_AUDIENCE=pharma-agent-os-api
OIDC_ALGORITHMS=RS256
ALLOWED_HOSTS=YOUR_DOMAIN,YOUR_API_HOST,YOUR_WORKER_HOST
ALLOWED_ORIGINS=https://YOUR_DOMAIN
# PORTAL_SESSION_SECRET, API_SESSION_PRIVATE_KEY and OIDC_PUBLIC_KEY
# are configured separately. No provider accounts or login callbacks are used. The web's API_BASE_URL is a service binding.

SERVERLESS_WORKER_ENABLED=false
WORKER_SLICE_SECONDS=210
# Set WORKER_TRIGGER_SECRET as a Vercel Secret and matching Supabase Vault entry.
# Enable only after migrations, Data API restrictions, worker lanes and recovery
# are qualified. Supabase Cron is the scheduler; no Vercel crons are installed.

OTEL_SERVICE_NAME=pharma-agent-os-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://YOUR_OTLP_COLLECTOR/v1/traces
LLM_PROVIDER=none
# OpenAI activation: LLM_PROVIDER=openai; OPENAI_API_KEY must be a Vercel Secret.
# Defaults select gpt-5-mini for chat, analysis and translation when model variables
# are omitted. Replace explicit Gemini model settings and clear fallback lists first.
EMBEDDING_ENABLED=false
# Enable approved models and their secret key after independent qualification.
SMTP_ENABLED=false
FDA_REQUEST_DELAY_SECONDS=30
FDA_ROBOTS_FAIL_CLOSED=true
FDA_USER_AGENT=PharmaAgentOS/0.1 (contact: YOUR_OPERATIONS_CONTACT)
