{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectVersionedEvidenceBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::replace-with-private-versioned-evidence-bucket"
    },
    {
      "Sid": "AppendAndVerifyEvidenceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::replace-with-private-versioned-evidence-bucket/*"
    }
  ]
}

