# Local developer placeholders only. These are not production secrets.
# Copy this file to infra/local/.env and replace the three *PASSWORD values.
LOCAL_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=fda_intel
POSTGRES_USER=fda_local
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-different-local-only-password
REDIS_PORT=6379

MINIO_ROOT_USER=fda_local_admin
MINIO_ROOT_PASSWORD=replace-with-another-local-only-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORE_BUCKET=fda-raw-local

