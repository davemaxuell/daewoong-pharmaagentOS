{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_BASE_URL"
        },
        {
          "type": "service",
          "service": "worker",
          "format": "url",
          "env": "RESEARCH_WORKER_URL"
        }
      ]
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "python ../../scripts/prepare-vercel-resources.py",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "includeFiles": "app/_resources/**"
        }
      }
    },
    "worker": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "app.worker_entrypoint:app",
      "buildCommand": "python ../../scripts/prepare-vercel-resources.py",
      "functions": {
        "app/worker_entrypoint.py": {
          "maxDuration": 300,
          "includeFiles": "app/_resources/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/internal/worker/research",
      "destination": {"service": "worker"}
    },
    {
      "source": "/internal/worker/cases",
      "destination": {"service": "worker"}
    },
    {
      "source": "/internal/worker/ingestion",
      "destination": {"service": "worker"}
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
